rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /user_profile_image/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && fileName == request.auth.uid + '.jpg';
    }

    match /tasks_rewards/{taskId}/{fileName} {
      function isTaskParticipant() {
        let task = firestore.get(/databases/(default)/documents/user_tasks/$(taskId)).data;
        return request.auth.uid == task.sender_uid || request.auth.uid == task.receiver_uid;
      }
      allow read, write: if request.auth != null && isTaskParticipant();
    }

    match /user_gallery_images/{uid}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
